# Devin v3 organization-scoped API
DEVIN_SERVICE_USER_TOKEN=<service-user credential, cog_...>
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxx
DEVIN_REPOSITORY_ID=<repo_path or clone URL, e.g. owner/repo>
DEVIN_API_BASE=https://api.devin.ai

# GitHub
GITHUB_WEBHOOK_SECRET=<random secret, also set on the repo webhook>
GITHUB_TOKEN=<token able to comment on issues and read PR state>
TARGET_REPOSITORY=owner/repo

# Policy
MAX_ACU_LIMIT=10
DEVIN_AUTOFIX_LABEL=devin-autofix
# Demo-only: skip Devin's action-approval prompts so an unattended session
# does not stall. Leave false in production; gate sensitive paths on humans.
BYPASS_APPROVAL=false

# Storage
DATABASE_PATH=/app/data/ops_guard.db
